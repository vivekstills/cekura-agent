# Copy to .env (gitignored). Never commit real values.
# OpenRouter key used ONLY when --model-mode openrouter is passed (live canary / demo).
OPENROUTER_API_KEY=
# Cekura platform key used ONLY when --platform-mode staging is passed.
CEKURA_API_KEY=
# Optional defaults picked up by planning when flags are omitted.
CEKURA_AGENT_ID=
CEKURA_PROJECT_ID=
